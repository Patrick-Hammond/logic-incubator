{
  "compileOnSave": false,
  "compilerOptions": {
    "sourceMap": false,
    "declaration": false,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "target": "es5",
    "typeRoots": [
      "./node_modules/@types"
    ],
    "lib": [
      "es2017",
      "dom"
    ],
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noUnusedParameters": false,
    "baseUrl": ".",
    "paths": {
      "@logic-incubator/lib/*": ["packages/lib/src/*"],
      "@logic-incubator/engine/*": ["packages/engine/src/*"],
      "@logic-incubator/editor/*": ["packages/editor/src/*"],
      "@logic-incubator/ui/*": ["packages/ui/src/*"]
    }
  },
  "include": ["packages/*/src"],
  "exclude": ["node_modules", "dist"]
}
